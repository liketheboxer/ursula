# Copy to .env for local runs. In Exocomp these are the unit's settings and secrets.

# Secret: the bot token from the Discord Developer Portal (Bot > Reset Token). Never commit it.
DISCORD_TOKEN=

# Optional: a server ID to sync slash commands to instantly while testing.
# Leave empty in production; commands then sync globally.
DEV_GUILD_ID=

# Optional: used until /pdc timezone is set on a server.
DEFAULT_TIMEZONE=America/Los_Angeles

# Local runs only; Exocomp uses /data.
DATA_DIR=./data
READY_FILE=./data/ready

LOG_LEVEL=INFO

# The Ansible (the Matrix mirror). The homeserver's client address (from
# https://magicalsamurai.com/.well-known/matrix/client) and a secret: Ursula's Matrix access token.
# Without both the Ansible stays off. Which channel and room are mirrored is set with /pdc ansible link.
MATRIX_HOMESERVER=https://anarres.magicalsamurai.com
MATRIX_ACCESS_TOKEN=

# Salas (music), optional secrets: a throwaway YouTube account's cookies, and a Spotify app's key.
YOUTUBE_COOKIES=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The Magical Samurai (Daisho): Ursula's management screens. Exocomp sets these itself at each refit
# once the Captain has picked Ursula as the unit's module and issued its token. Without them Ursula
# simply doesn't sync.
SAMURAI_URL=
SAMURAI_PUBLIC_URL=
SAMURAI_MODULE_TOKEN=
